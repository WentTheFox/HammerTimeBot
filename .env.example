LOCAL=true
DEBUG_I18N=false
DISABLE_SETTINGS=false
UA_STRING="gh:WentTheFox/HammerTimeBot"
DISCORD_INVITE_URL="https://discord.gg/#example-invite-url"

# SledgeHammerTime Integration
API_URL=http://127.0.0.1:8000
# Generate via `php artisan bot-token:generate`
API_TOKEN=

# Discord API
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Only used by the webhook entrypoint (src/webhook.ts) - "Public Key" on the app's Developer Portal page
DISCORD_PUBLIC_KEY=
# Only used by the webhook entrypoint (src/webhook.ts)
WEBHOOK_PORT=3939
# Only used by the webhook entrypoint (src/webhook.ts) - long random URL-safe token; the webhook
# only serves interactions at /<this>, set that as the Interactions Endpoint URL on the Developer
# Portal. Generate via `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
WEBHOOK_PATH_SECRET=
# Only used by the webhook entrypoint (src/webhook.ts) - enables discord-bot-framework's
# verboseSignatureDiagnostics (exact signature/timestamp, body hash, type/id if JSON) for
# diagnosing signature-rejection failures beyond the default metadata-only diagnostic
WEBHOOK_VERBOSE_DIAGNOSTICS=false
# Guild ID used to resolve role mentions in FAQ entries (optional)
SUPPORT_SERVER_ID=
# Discord webhook URL logs of warn level and above are fanned out to (optional)
DISCORD_LOG_WEBHOOK_URL=

# Crowdin API
CROWDIN_API_KEY=
CROWDIN_PROJECT_IDENTIFIER=
CROWDIN_REPORT_CACHE=true
CROWDIN_REPORT_DEBUG=false
CROWDIN_DEVELOPER_ID=13617551
