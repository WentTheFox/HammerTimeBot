# Log retention for git-deploy-toolkit (installed on each deploy; see its
# docs/logrotate.md).
#
# Retention follows the privacy policy this bot's Terms and Privacy.md points
# to (the SledgeHammerTime site's legal page, lang/en/legal.php): "The Bot
# records Command executions for debugging purposes ... This data is stored on
# the Project server for up to 30 days". The webhook process's output is where
# those records end up, so it is kept for at most 30 days.
# With `daily`, `rotate 29` keeps today's file plus 29 rotated ones, so
# nothing is older than 30 days. `maxage 30` is a second, independent cap.
#
# sync-commands.log (appended by deploy.conf) holds no per-user data; it is
# kept for two weeks. Both are owned by the deploy user.

@WORKTREE@/logs/pm2-webhook-out.log
@WORKTREE@/logs/pm2-webhook-error.log {
	su chisel chisel
	daily
	rotate 29
	maxage 30
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
}

@WORKTREE@/sync-commands.log {
	su chisel chisel
	daily
	rotate 13
	maxage 14
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
}

# nginx's access and error logs for the bot's vhost. They used to sit in the
# system-wide /var/log/nginx, which the distro rotates for 52 days; here the
# same retention as the webhook process applies. Their own directory, so it
# can be group-writable for www-data (who writes them) without making the
# pm2 directory above it insecure for logrotate.
@WORKTREE@/logs/nginx/access.log {
	su www-data www-data
	daily
	rotate 29
	maxage 30
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
}

# Error log: no command data, so the Log Data section's 14 days applies.
@WORKTREE@/logs/nginx/error.log {
	su www-data www-data
	daily
	rotate 13
	maxage 14
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
}
