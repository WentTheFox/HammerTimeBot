# Copy to packages/api/.env on the server (pm2.json passes it to the API process with --env-file). Git ignores that file.
# The API server never reads the bot's .env.

# Where to listen. Put a reverse proxy in front of it, the default only accepts local connections.
HOST=127.0.0.1
PORT=3010

# The Laravel app (SledgeHammerTime), which owns the users, API keys, settings and telemetry
LARAVEL_URL=https://hammertime.cyou

# Must equal INTERNAL_API_SECRET in the Laravel app's .env, e.g. generate it with `openssl rand -hex 32`
INTERNAL_API_SECRET=

# How long an API key is trusted without asking Laravel again. A revoked key keeps working that long. 0 turns it off.
KEY_CACHE_TTL_SECONDS=30

# Limits per minute. A key (or, for the bot's service key, the Discord account it acts for) may make this many requests on
# average, with a burst of half of it unless RATE_LIMIT_BURST is set. 0 turns a limit off.
RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_BURST=30
# A client address that fails to authenticate this often is turned away for a while, so bad keys do not each cost a lookup
AUTH_FAILURES_PER_MINUTE=20
# Behind a reverse proxy every client has the proxy's address. Name a header the proxy sets to the client's address and
# overwrites (nginx: proxy_set_header X-Real-IP $remote_addr;) so each client is counted on its own. Leave it out when the
# proxy does not overwrite it, otherwise anyone can choose the address they are counted under.
# CLIENT_IP_HEADER=X-Real-IP
