# Copy to .env.api in the repository root on the server (pm2.json passes it to the API process with --env-file).
# The API server never reads the bot's .env.

# Where to listen. Put a reverse proxy in front of it, the default only accepts local connections.
HOST=127.0.0.1
PORT=3010

# The Laravel app (SledgeHammerTime), which owns the users, API keys, settings and telemetry
LARAVEL_URL=https://hammertime.cyou

# Must equal INTERNAL_API_SECRET in the Laravel app's .env, e.g. generate it with `openssl rand -hex 32`
INTERNAL_API_SECRET=

# How long an API key is trusted without asking Laravel again. A revoked key keeps working that long. 0 turns it off.
KEY_CACHE_TTL_SECONDS=30
