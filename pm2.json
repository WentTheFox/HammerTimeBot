{
  "apps": [
    {
      "name": "HammerTimeBot:Webhook",
      "script": "build/src/webhook.js",
      "exec_mode": "cluster",
      "instances": 2,
      "wait_ready": true,
      "listen_timeout": 30000,
      "kill_timeout": 10000,
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "out_file": "logs/pm2-webhook-out.log",
      "error_file": "logs/pm2-webhook-error.log",
      "merge_logs": true,
      "source_map_support": true,
      "env": {
        "NODE_OPTIONS": "--use-openssl-ca"
      }
    },
    {
      "name": "HammerTimeBot:Api",
      "script": "packages/api/dist/src/server.js",
      "exec_mode": "cluster",
      "instances": 2,
      "wait_ready": true,
      "listen_timeout": 30000,
      "kill_timeout": 10000,
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "out_file": "logs/pm2-api-out.log",
      "error_file": "logs/pm2-api-error.log",
      "merge_logs": true,
      "source_map_support": true,
      "env": {
        "NODE_OPTIONS": "--use-openssl-ca"
      }
    }
  ]
}
